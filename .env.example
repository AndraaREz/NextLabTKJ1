# =========================
# SUPABASE AUTH + DATABASE
# =========================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =========================
# AI PROVIDERS (SERVER ONLY)
# Put these in Vercel -> Settings -> Environment Variables.
# Never use NEXT_PUBLIC_ for API keys.
# =========================
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# GitHub Models has a free, rate-limited API.
# Use a GitHub token with Models read permission.
GITHUB_MODELS_TOKEN=

# Ollama: local is fine for local development.
# On Vercel, localhost points to the Vercel server, not your phone/PC.
OLLAMA_BASE_URL=http://127.0.0.1:11434/api
OLLAMA_API_KEY=

# Optional Supabase admin key. Keep server-only.
SUPABASE_SERVICE_ROLE_KEY=
